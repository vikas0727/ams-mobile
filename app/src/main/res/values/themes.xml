<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Fullscreen, no action bar, black window background. A signage panel shows content edge to
        edge; any system chrome behind a slow-loading asset flashes as a light band on a wall.
    -->
    <style name="Theme.Digi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
