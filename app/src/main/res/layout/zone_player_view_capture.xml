<?xml version="1.0" encoding="utf-8"?>
<!--
    The video surface for one zone — the CAPTURABLE path, used only while an operator has Live Data
    View open on this screen, or when the zone needs to alpha-fade its video.

    PlayerView's default SurfaceView is composited OUTSIDE the app's window, so
    `PixelCopy.request(window, ...)` — what both the SCREENSHOT command and the live frame stream
    use — captures every overlay and none of the video: the CMS preview comes back as a solid black
    rectangle on a screen that is playing perfectly.

    A TextureView renders into the view hierarchy, so it is part of the window and the capture shows
    what is really on the wall. It can also be alpha-composited, which a SurfaceView cannot, and a
    zone that mixes images with video relies on that to hide the video layer behind an image.

    The cost is one extra full-frame GPU copy at the video's frame rate, which is why this is no
    longer the default — see zone_player_view.xml.

    surface_type can only be set here — PlayerView reads it at inflation and it cannot be changed in
    code afterwards — which is why this file exists rather than a builder call in ZoneRenderer.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:hide_on_touch="false"
    app:resize_mode="fit" />
