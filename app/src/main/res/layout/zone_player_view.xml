<?xml version="1.0" encoding="utf-8"?>
<!--
    The video surface for one zone.

    This layout exists for exactly one attribute: `surface_type="texture_view"`.

    PlayerView defaults to a SurfaceView, which SurfaceFlinger composites OUTSIDE the app's window.
    `PixelCopy.request(window, ...)` — what the SCREENSHOT command uses — reads the window's own
    surface, so with a SurfaceView it captures every overlay and none of the video: the CMS's Live
    Data View preview comes back as a solid black rectangle on a screen that is playing perfectly.

    A TextureView renders into the view hierarchy, so it is part of the window and the capture shows
    what is actually on the wall. The cost is one extra GPU copy per frame versus a SurfaceView; for
    1080p H.264 on the Droidlogic units that is comfortably affordable, and a remote screenshot that
    never works is worse than a few percent of GPU.

    surface_type can only be set here — PlayerView reads it at inflation and it cannot be changed in
    code afterwards — which is why this file exists rather than a builder call in ZoneRenderer.
    If a future panel ever struggles with 4K, switching back is a one-word edit here, at the price of
    black screenshots.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:hide_on_touch="false"
    app:resize_mode="fit" />
